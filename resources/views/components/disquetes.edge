{{--
  Nota em disquetes (somente leitura).
  Props: nota (0–5; decimal é arredondado; vazio = 0) e tamanho (px, padrão 24).
  Ex.:
  @!disquetes({ nota: registro.nota, tamanho: 18 })
--}}
@let(nota = Math.min(5, Math.max(0, Math.round(Number($props.get('nota')) || 0))))
@let(tamanho = $props.get('tamanho') ?? 24)
<span
  role="img"
  aria-label="Nota {{ nota }} de 5"
  class="inline-flex shrink-0 items-center align-middle {{ $props.get('class') ?? '' }}"
  style="gap: {{ Math.max(2, Math.round(tamanho / 6)) }}px"
>
  @each(i in [1, 2, 3, 4, 5])
    @let(corpo = i <= nota ? '#D6336C' : '#CDBBD0')
    @let(janela = i <= nota ? '#2A1630' : '#E4DCE6')
    @let(etiqueta = i <= nota ? '#FFFFFF' : '#E4DCE6')
    <svg
      width="{{ tamanho }}"
      height="{{ tamanho }}"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M2.5 4.5Q2.5 2.5 4.5 2.5H18L21.5 6V19.5Q21.5 21.5 19.5 21.5H4.5Q2.5 21.5 2.5 19.5Z"
        fill="{{ corpo }}"
      />
      <rect x="7" y="2.5" width="9.5" height="6.5" fill="{{ janela }}" />
      <rect x="13" y="3.5" width="2" height="4.5" fill="{{ corpo }}" />
      <rect x="5.5" y="12.5" width="13" height="9" rx="1" fill="{{ etiqueta }}" />
    </svg>
  @end
</span>
