{{-- Logo do cabeçalho: três triângulos "avançar" com o nome embaixo. --}}
@link({
  route: 'home',
  'aria-label': 'videoboxd',
  class: 'inline-flex flex-col items-center leading-none text-white',
})
  <svg width="46" height="24" viewBox="0 0 46 24" aria-hidden="true">
    <path d="M0 0L20 12L0 24Z" fill="#7A2A4F" />
    <path d="M13 0L33 12L13 24Z" fill="#D6336C" />
    <path d="M26 0L46 12L26 24Z" fill="#E4DCE6" />
    <path d="M13 7.8L20 12L13 16.2Z" fill="#AD385D" />
    <path d="M26 7.8L33 12L26 16.2Z" fill="#E998AC" />
  </svg>
  <span class="font-logo text-2xl font-black tracking-tight" aria-hidden="true">videoboxd</span>
@end
