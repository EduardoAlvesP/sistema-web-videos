{{-- Telas de entrar e criar conta: no topo, o link para a outra tela. --}}
@let(pageTitle = $props.get('title'))
@let(naTelaDeLogin = request.url() === urlFor('session.create'))
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    @include('partials/head')
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-papel text-tinta font-sans">
    <header class="bg-tinta text-papel">
      <div
        class="mx-auto flex min-h-[84px] max-w-[1168px] items-center justify-between gap-4 px-4 sm:px-6"
      >
        @!logo()
        @if(naTelaDeLogin)
          @link({
            route: 'new_account.create',
            class: 'font-bold underline underline-offset-4 hover:text-white',
          })
            Criar conta
          @end
        @else
          @link({
            route: 'session.create',
            class: 'font-bold underline underline-offset-4 hover:text-white',
          })
            Entrar
          @end
        @end
      </div>
    </header>
    <main class="flex justify-center px-4 py-12 sm:py-16">{{{ await $slots.main() }}}</main>
    @include('partials/flash_alerts')
  </body>
</html>
