@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    @include('partials/head')
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-papel text-tinta font-sans">
    <header class="bg-tinta text-papel">
      <div
        class="mx-auto flex min-h-[84px] max-w-[1168px] items-center justify-between gap-4 px-4 sm:px-6"
      >
        @!logo()
        <div class="flex items-center gap-4 sm:gap-5">
          @if(auth?.user)
            @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
              Perfil
            @end
          @else
            @link({
              route: 'session.create',
              class: 'font-semibold hover:underline underline-offset-4',
            })
              Entrar
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
