{{--
  Navegação principal do app. Cada item vira um link no cabeçalho, com o
  estado ativo marcado. `inativoEm` lista rotas que não acendem o item
  (ex.: "Vídeos" não fica ativo em "Enviar vídeo").
--}}
@let(nav = [
  { label: 'Vídeos', route: 'videos.index', inativoEm: ['videos.create'] },
  { label: 'Enviar vídeo', route: 'videos.create', exact: true },
  { label: 'Dashboard', route: 'dashboard', exact: true },
  ...(auth.user?.papel === 'admin' ? [{ label: 'Admin', route: 'admin.videos.index' }] : []),
])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    @include('partials/head')
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-papel text-tinta font-sans">
    <header class="bg-tinta text-papel">
      <div
        class="mx-auto flex max-w-[1168px] flex-wrap items-center justify-between gap-x-8 gap-y-2 px-4 py-3 sm:px-6 md:min-h-[84px] md:flex-nowrap"
      >
        @!logo()
        <nav
          aria-label="Principal"
          class="order-3 flex w-full flex-wrap gap-x-5 gap-y-1 md:order-none md:w-auto md:flex-1"
        >
          @each(item in nav)
            @navLink({
              route: item.route,
              exact: item.exact,
              inativoEm: item.inativoEm,
              class:
                'py-1 font-semibold underline-offset-[6px] decoration-2 decoration-rosa hover:text-white aria-[current=page]:text-white aria-[current=page]:underline',
            })
              {{ item.label }}
            @end
          @end
        </nav>
        @form({ route: 'session.destroy', method: 'POST' })
          <button type="submit" class="btn btn--secondary btn--sm">
            @svg('lucide:log-out', { width: 15, height: 15 })
            
            Sair

          </button>
        @end
      </div>
    </header>

    <main class="flex min-h-[calc(100vh-84px)]">{{{ await $slots.main() }}}</main>
    @include('partials/flash_alerts')
  </body>
</html>
