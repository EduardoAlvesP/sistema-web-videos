@layouts.app({ title: video.titulo })
  @page()
    <h1>{{ video.titulo }}</h1>

    <div style="position: relative; width: 100%; aspect-ratio: 16 / 9;">
      <iframe
        src="https://www.youtube.com/embed/{{ video.youtubeId }}"
        title="{{ video.titulo }}"
        style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
    @section({ title: 'Informações' })
      <dl>
        <dt>Canal</dt>
        <dd>{{ video.canal ? video.canal.nome : '—' }}</dd>
        <dt>Publicado por</dt>
        <dd>{{ video.publicador ? video.publicador.nome : '—' }}</dd>
        <dt>Data de publicação</dt>
        <dd>{{ video.createdAt ? video.createdAt.toFormat('dd/MM/yyyy') : '—' }}</dd>
      </dl>
      <p>
        @link({
          href: `https://www.youtube.com/watch?v=${video.youtubeId}`,
          target: '_blank',
          rel: 'noopener noreferrer',
        })
          Ver no YouTube
        @end
      </p>
    @end
    @section({ title: 'Assistido' })
      @if(meusRegistros.length)
        <p>
          {{ `Você assistiu este vídeo ${meusRegistros.length} vez(es). A última foi em ${meusRegistros[0].dataAssistido.toFormat('dd/MM/yyyy')}.` }}
        </p>
        <ul>
          @each(registro in meusRegistros)
            <li>
              {{ `${registro.dataAssistido.toFormat('dd/MM/yyyy')} — ${registro.nota ? `nota ${registro.nota}` : 'sem nota'}` }}
              @form({
                route: 'registros.destroy',
                routeParams: { id: registro.id },
                method: 'POST',
                style: 'display: inline;',
              })
                @!button({ text: 'Remover', type: 'submit' })
              @end
            </li>
          @end
        </ul>
      @end
      @form({ route: 'registros.store', routeParams: { id: video.id }, method: 'POST' })
        @field.root({ name: 'data_assistido' })
          @!field.label({ text: 'Data' })
          @!input.control({ type: 'date', value: hoje, max: hoje })
          @!field.error()
        @end
        @field.root({ name: 'nota' })
          @!field.label({ text: 'Nota' })
          @!select.control({
            options: [
              { value: '', name: 'Sem nota' },
              { value: '1', name: '1' },
              { value: '2', name: '2' },
              { value: '3', name: '3' },
              { value: '4', name: '4' },
              { value: '5', name: '5' },
            ],
          })
          @!field.error()
        @end
        @!button({ text: 'Marcar como assistido', type: 'submit' })
      @end
    @end
    @section({ title: 'Nota média' })
      @if(notaMedia)
        <p>
          {{ `${notaMedia} em ${totalNotas} ${totalNotas === 1 ? 'avaliação' : 'avaliações'}` }}
        </p>
      @else
        <p>Ainda sem notas</p>
      @end
    @end
    @section({ title: 'Reviews' })
      <p>Em breve</p>
    @end
    @section({ title: 'Tags' })
      @if(video.tags.length)
        <ul>
          @each(tag in video.tags)
            <li>{{ tag.nome }}</li>
          @end
        </ul>
      @else
        <p>Em breve</p>
      @end
    @end
  @end
@end
