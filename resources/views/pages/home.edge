@layouts.marketing()
  <main class="mx-auto max-w-[1168px] px-4 pt-16 pb-20 sm:px-6">
    <section class="flex flex-col items-center text-center">
      <svg
        class="h-auto w-[150px] sm:w-[192px]"
        width="192"
        height="100"
        viewBox="0 0 46 24"
        aria-hidden="true"
      >
        <path d="M0 0L20 12L0 24Z" fill="#7A2A4F" />
        <path d="M13 0L33 12L13 24Z" fill="#D6336C" />
        <path d="M26 0L46 12L26 24Z" fill="#2A1630" />
        <path d="M13 7.8L20 12L13 16.2Z" fill="#AD385D" />
        <path d="M26 7.8L33 12L26 16.2Z" fill="#5B2448" />
      </svg>
      <h1 class="mt-4 font-logo text-[64px] font-black leading-none tracking-tight sm:text-[88px]">
        videoboxd
      </h1>
      <p class="mt-5 text-lg text-apagado sm:text-xl">
        Registre, avalie e descubra vídeos do YouTube.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-4 gap-y-2">
        @if(auth?.user)
          @link({ route: 'videos.index', class: 'btn btn--primary' })
            Ver vídeos
          @end
        @else
          @link({ route: 'new_account.create', class: 'btn btn--primary' })
            Criar conta
          @end
          @link({ route: 'session.create', class: 'btn btn--secondary' })
            Entrar
          @end
        @end
      </div>
    </section>

    <section class="mt-16 grid gap-7 md:grid-cols-3">
      <article class="box p-6">
        <svg width="48" height="42" viewBox="0 0 48 42" aria-hidden="true">
          <path d="M34 10L48 4V30L34 24Z" fill="#7A2A4F" />
          <rect x="0" y="0" width="36" height="34" rx="4" fill="#2A1630" />
          <rect x="4" y="4" width="22" height="18" rx="3" fill="#D6336C" />
          <path d="M12 8.5L19 13L12 17.5Z" fill="#fff" />
          <circle cx="28" cy="29" r="2" fill="#D6336C" />
          <circle cx="32" cy="29" r="2" fill="#D6336C" />
          <rect x="8" y="34" width="20" height="5" fill="#2A1630" />
        </svg>
        <h2 class="mt-4 font-display text-xl">Arquive</h2>
        <p class="mt-2 leading-relaxed text-apagado">
          Cole o link de um vídeo do YouTube e ele entra no acervo, com título, canal e capa.
        </p>
      </article>
      <article class="box p-6">
        <div class="flex h-[42px] items-center gap-1.5" aria-hidden="true">
          @each(i in [1, 2, 3, 4, 5])
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              class="{{ i === 5 ? 'opacity-30' : '' }}"
            >
              <path d="M2 2H19L22 5V22H2Z" fill="#D6336C" />
              <rect x="6" y="2" width="11" height="7" fill="#2A1630" />
              <rect x="13" y="3" width="2.5" height="5" fill="#fff" />
              <rect x="5" y="13" width="14" height="9" fill="#fff" />
            </svg>
          @end
        </div>
        <h2 class="mt-4 font-display text-xl">Dê sua nota</h2>
        <p class="mt-2 leading-relaxed text-apagado">
          De um a cinco disquetes. Assistiu de novo? Registre de novo.
        </p>
      </article>
      <article class="box p-6">
        <div class="flex h-[42px] items-center" aria-hidden="true">
          <span class="border-2 border-tinta px-2.5 py-0.5 font-mono text-[15px] font-bold">
            Ficha nº 0112
          </span>
        </div>
        <h2 class="mt-4 font-display text-xl">Preencha a ficha</h2>
        <p class="mt-2 leading-relaxed text-apagado">
          Escreva o que achou. Os outros curtem, comentam e seguem você.
        </p>
      </article>
    </section>
  </main>
@end
