@layouts.app({ title: 'Admin · Usuários' })
  <div class="page">
    <nav aria-label="Admin" class="flex gap-5">
      @link({ route: 'admin.videos.index', class: 'il' })
        Vídeos
      @end
      @link({ route: 'admin.users.index', class: 'il' })
        Usuários
      @end
    </nav>
    <h1 class="mt-6 mb-6 font-display text-[32px] leading-tight">Usuários</h1>
    @if(users.length)
      <div class="overflow-x-auto shadow-[4px_4px_0_var(--color-tinta)]">
        <table class="tabela">
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Papel</th>
              <th>Vídeos publicados</th>
              <th>Cadastro</th>
            </tr>
          </thead>
          <tbody>
            @each(user in users)
              <tr data-user-row>
                <td>{{ user.nome }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.papel }}</td>
                <td>{{ user.$extras.videosPublicados_count }}</td>
                <td>{{ user.createdAt.toFormat('dd/MM/yyyy HH:mm') }}</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <p class="text-apagado">Nenhum usuário cadastrado.</p>
    @end
    @if(users.hasPages)
      <nav aria-label="Paginação" class="mt-8 flex flex-wrap items-center gap-4">
        @if(users.currentPage > 1)
          @link({
            href: users.getPreviousPageUrl(),
            class: 'btn btn--secondary btn--sm',
          })
            Anterior
          @end
        @end

        <span class="font-mono text-sm">
          Página
          {{ users.currentPage }}
          de
          {{ users.lastPage }}
        </span>
        @if(users.hasMorePages)
          @link({ href: users.getNextPageUrl(), class: 'btn btn--secondary btn--sm' })
            Próxima
          @end
        @end
      </nav>
    @end
  </div>
@end
