@layouts.marketing({ title: '404' })
  <main class="flex justify-center px-4 py-16">
    <article class="box w-full max-w-[580px] p-6 sm:p-10">
      <span class="border-2 border-tinta px-2.5 py-0.5 font-mono font-bold">404</span>
      <h1 class="mt-6 font-display text-2xl sm:text-3xl">Não encontrado</h1>
      <p class="mt-3 text-apagado">
        A página que você tentou abrir não existe ou foi removida. Confira o endereço.
      </p>
      <div class="mt-7">
        @link({ route: 'home', class: 'btn btn--primary' })
          Voltar ao início
        @end
      </div>
    </article>
  </main>
@end
