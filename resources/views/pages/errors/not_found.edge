@layouts.marketing({ title: '404' })
  <main class="flex justify-center px-4 py-16">
    <article class="box w-full max-w-[580px] p-6 sm:p-10">
      <span class="border-2 border-tinta px-2.5 py-0.5 font-mono font-bold">404</span>
      <h1 class="mt-6 font-display text-2xl sm:text-3xl">Not found.</h1>
      <p class="mt-2 text-lg">That route hasn't been built yet.</p>
      <p class="mt-4 text-apagado">
        The page you tried to reach doesn't exist. Check the URL or head back home.
      </p>
    </article>
  </main>
@end
