@layouts.marketing({ title: 'Erro' })
  <main class="flex justify-center px-4 py-16">
    <article class="box w-full max-w-[580px] p-6 sm:p-10">
      <span class="border-2 border-erro px-2.5 py-0.5 font-mono font-bold text-erro">
        {{ error.code || 500 }}
      </span>
      <h1 class="mt-6 font-display text-2xl sm:text-3xl">Something broke.</h1>
      <p class="mt-2 text-lg">The server hit an unexpected error.</p>
      <p class="mt-4 text-apagado">
        Try again in a moment. If the problem persists, check the server logs for the underlying exception.
      </p>
    </article>
  </main>
@end
