@layouts.marketing({ title: 'Erro' })
  <main class="flex justify-center px-4 py-16">
    <article class="box w-full max-w-[580px] p-6 sm:p-10">
      <span class="border-2 border-erro px-2.5 py-0.5 font-mono font-bold text-erro">
        {{ error.code || 500 }}
      </span>
      <h1 class="mt-6 font-display text-2xl sm:text-3xl">Algo deu errado</h1>
      <p class="mt-3 text-apagado">
        O servidor encontrou um erro inesperado. Tente de novo em instantes.
      </p>
      <div class="mt-7">
        @link({ route: 'home', class: 'btn btn--primary' })
          Voltar ao início
        @end
      </div>
    </article>
  </main>
@end
